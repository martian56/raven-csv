// raven-csv: read and write CSV (RFC 4180) in pure Raven.
//
//     from "github.com/martian56/raven-csv" import Csv, Table
//
//     match Csv.new().with_header().parse(text) {
//         Ok(table) -> {
//             let name = table.field(0, "name")     // by header
//             let cell = table.get(0, 1)            // by row/column
//         },
//         Err(e) -> print(e.to_string()),
//     }
//
// Fields may be quoted with double quotes; a quoted field can contain the
// delimiter, newlines, and escaped quotes (`""`). The delimiter defaults to a
// comma and is configurable for TSV and friends.

import std.string

// A parse error, carrying the 1-based line where it was found.
class CsvError {
    line: int
    message: str
}

impl CsvError {
    fun new(line: int, message: str) -> CsvError {
        return CsvError(line: line, message: message)
    }
}

impl ToString for CsvError {
    fun to_string(self) -> str {
        return "csv:${self.line}: ${self.message}"
    }
}

// A parsed CSV document: optional header names and the data rows. A row is a
// list of string fields; rows may be ragged (different lengths).
class Table {
    headers: list[str]
    rows: list[list[str]]
}

impl Table {
    // The number of data rows (excluding the header).
    fun row_count(self) -> int {
        return self.rows.len()
    }

    // The number of columns, from the header if present, else the first row.
    fun col_count(self) -> int {
        if self.headers.len() > 0 {
            return self.headers.len()
        }
        if self.rows.len() > 0 {
            return self.rows[0].len()
        }
        return 0
    }

    // The data row at `i`, or an empty row when out of range.
    fun row(self, i: int) -> list[str] {
        if i < 0 or i >= self.rows.len() {
            return _new_row()
        }
        return self.rows[i]
    }

    // The cell at (`row`, `col`), or `""` when out of range.
    fun get(self, row: int, col: int) -> str {
        if row < 0 or row >= self.rows.len() {
            return ""
        }
        let r = self.rows[row]
        if col < 0 or col >= r.len() {
            return ""
        }
        return r[col]
    }

    // The cell in `row` under the header named `name`, or `None` when there is
    // no such header or row.
    fun field(self, row: int, name: str) -> Option[str] {
        let col = _header_index(self.headers, name)
        if col < 0 {
            return None
        }
        if row < 0 or row >= self.rows.len() {
            return None
        }
        let r = self.rows[row]
        if col >= r.len() {
            return None
        }
        return Some(r[col])
    }
}

// A configurable CSV reader. Build one with `Csv.new()` and refine it with the
// fluent methods, each of which returns a configured copy.
class Csv {
    delimiter: str
    has_header: bool
    trim: bool
}

impl Csv {
    // A reader with a comma delimiter, no header row, and no field trimming.
    fun new() -> Csv {
        return Csv(delimiter: ",", has_header: false, trim: false)
    }

    // Use `d` (a single character) as the field delimiter, for example a tab.
    fun delimiter(self, d: str) -> Csv {
        return Csv(delimiter: d, has_header: self.has_header, trim: self.trim)
    }

    // Treat the first row as header names, accessible with `Table.field`.
    fun with_header(self) -> Csv {
        return Csv(delimiter: self.delimiter, has_header: true, trim: self.trim)
    }

    // Trim surrounding whitespace from unquoted fields.
    fun trimmed(self) -> Csv {
        return Csv(delimiter: self.delimiter, has_header: self.has_header, trim: true)
    }

    // Parse `text` into a `Table`. The only error is an unterminated quote.
    fun parse(self, text: str) -> Result[Table, CsvError] {
        let records: list[list[str]] = []
        var record = _new_row()
        var field = ""
        var field_quoted = false
        var in_quotes = false
        var started = false
        var line = 1
        var i = 0
        let n = text.length()
        while i < n {
            let c = text.char_at(i)
            if c == "\"" {
                if i + 1 < n and text.char_at(i + 1) == "\"" {
                    field = field.concat("\"")
                    i += 2
                } else {
                    in_quotes = false
                    i += 1
                }
            } else {
                if c == "\n" {
                    line += 1
                }
                field = field.concat(c)
                i += 1
            } if in_quotes else if c == "\"" and field == "" and not field_quoted {
                in_quotes = true
                field_quoted = true
                started = true
                i += 1
            } else if c == self.delimiter {
                record.push(self._finish(field, field_quoted))
                field = ""
                field_quoted = false
                started = true
                i += 1
            } else if c == "\n" {
                if started or record.len() > 0 or field_quoted {
                    record.push(self._finish(field, field_quoted))
                    records.push(record)
                    record = _new_row()
                }
                field = ""
                field_quoted = false
                started = false
                line += 1
                i += 1
            } else if c == "\r" {
                i += 1
            } else {
                field = field.concat(c)
                started = true
                i += 1
            }
        }
        if in_quotes {
            return Err(CsvError.new(line, "unterminated quoted field"))
        }
        if started or record.len() > 0 or field_quoted {
            record.push(self._finish(field, field_quoted))
            records.push(record)
        }
        return Ok(self._to_table(records))
    }

    fun _finish(self, field: str, quoted: bool) -> str {
        if self.trim and not quoted {
            return field.trim()
        }
        return field
    }

    fun _to_table(self, records: list[list[str]]) -> Table {
        if self.has_header and records.len() > 0 {
            let headers = records[0]
            let rows: list[list[str]] = []
            var i = 1
            while i < records.len() {
                rows.push(records[i])
                i += 1
            }
            return Table(headers: headers, rows: rows)
        }
        let no_headers: list[str] = []
        return Table(headers: no_headers, rows: records)
    }
}

// Serialize `rows` to CSV text with a comma delimiter, quoting fields that need
// it and terminating each record with a newline.
fun write(rows: list[list[str]]) -> str {
    return write_with(rows, ",")
}

// Serialize `rows` using `delimiter` as the field separator.
fun write_with(rows: list[list[str]], delimiter: str) -> str {
    var out = ""
    var i = 0
    while i < rows.len() {
        let r = rows[i]
        var j = 0
        while j < r.len() {
            if j > 0 {
                out = out.concat(delimiter)
            }
            out = out.concat(_escape(r[j], delimiter))
            j += 1
        }
        out = out.concat("\n")
        i += 1
    }
    return out
}

// Quote a field when it contains the delimiter, a quote, or a line break,
// doubling any embedded quotes.
fun _escape(field: str, delimiter: str) -> str {
    let risky = field.contains(delimiter) or field.contains("\"") or field.contains("\n") or field.contains(
        "\r",
    )
    if risky {
        return "\"".concat(field.replace("\"", "\"\"")).concat("\"")
    }
    return field
}

fun _new_row() -> list[str] {
    let r: list[str] = []
    return r
}

fun _header_index(headers: list[str], name: str) -> int {
    var i = 0
    while i < headers.len() {
        if headers[i] == name {
            return i
        }
        i += 1
    }
    return 0 - 1
}
