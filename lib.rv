// raven-csv: read and write CSV (RFC 4180) in pure Raven.
//
//     import "github.com/martian56/raven-csv" { Csv, Sheet }
//
//     match Csv.new().with_header().parse(text) {
//         Ok(table) -> {
//             let name = table.field(0, "name")     // by header
//             let cell = table.get(0, 1)            // by row/column
//         },
//         Err(e) -> print(e.to_string()),
//     }
//
// Fields may be quoted with double quotes; a quoted field can contain the
// delimiter, newlines, and escaped quotes (`""`). The delimiter defaults to a
// comma and is configurable for TSV and friends.

import std/string

// A parse error, carrying the 1-based line where it was found.
struct CsvError {
    line: Int,
    message: String,
}

impl CsvError {
    fun new(line: Int, message: String) -> CsvError {
        return CsvError { line, message }
    }
}

impl ToString for CsvError {
    fun to_string(self) -> String {
        return "csv:${self.line}: ${self.message}"
    }
}

// A parsed CSV document: optional header names and the data rows. A row is a
// list of string fields; rows may be ragged (different lengths).
struct Sheet {
    headers: List<String>,
    rows: List<List<String>>,
}

impl Sheet {
    // The number of data rows (excluding the header).
    fun row_count(self) -> Int {
        return self.rows.len()
    }

    // The number of columns, from the header if present, else the first row.
    fun col_count(self) -> Int {
        if self.headers.len() > 0 {
            return self.headers.len()
        }
        if self.rows.len() > 0 {
            return self.rows[0].len()
        }
        return 0
    }

    // The data row at `i`, or an empty row when out of range.
    fun row(self, i: Int) -> List<String> {
        if i < 0 || i >= self.rows.len() {
            return _new_row()
        }
        return self.rows[i]
    }

    // The cell at (`row`, `col`), or `""` when out of range.
    fun get(self, row: Int, col: Int) -> String {
        if row < 0 || row >= self.rows.len() {
            return ""
        }
        let r = self.rows[row]
        if col < 0 || col >= r.len() {
            return ""
        }
        return r[col]
    }

    // The cell in `row` under the header named `name`, or `None` when there is
    // no such header or row.
    fun field(self, row: Int, name: String) -> Option<String> {
        let col = _header_index(self.headers, name)
        if col < 0 {
            return None
        }
        if row < 0 || row >= self.rows.len() {
            return None
        }
        let r = self.rows[row]
        if col >= r.len() {
            return None
        }
        return Some(r[col])
    }
}

// A configurable CSV reader. Build one with `Csv.new()` and refine it with the
// fluent methods, each of which returns a configured copy.
struct Csv {
    delimiter: String,
    has_header: Bool,
    trim: Bool,
}

impl Csv {
    // A reader with a comma delimiter, no header row, and no field trimming.
    fun new() -> Csv {
        return Csv { delimiter: ",", has_header: false, trim: false }
    }

    // Use `d` (a single character) as the field delimiter, for example a tab.
    fun delimiter(self, d: String) -> Csv {
        return Csv { delimiter: d, has_header: self.has_header, trim: self.trim }
    }

    // Treat the first row as header names, accessible with `Sheet.field`.
    fun with_header(self) -> Csv {
        return Csv { delimiter: self.delimiter, has_header: true, trim: self.trim }
    }

    // Trim surrounding whitespace from unquoted fields.
    fun trimmed(self) -> Csv {
        return Csv { delimiter: self.delimiter, has_header: self.has_header, trim: true }
    }

    // Parse `text` into a `Sheet`. The only error is an unterminated quote.
    fun parse(self, text: String) -> Result<Sheet, CsvError> {
        let records: List<List<String>> = []
        let record = _new_row()
        let field = ""
        let field_quoted = false
        let in_quotes = false
        let started = false
        let line = 1
        let i = 0
        let n = text.length()
        while i < n {
            let c = text.char_at(i)
            if in_quotes {
                if c == "\"" {
                    if i + 1 < n && text.char_at(i + 1) == "\"" {
                        field = field.concat("\"")
                        i += 2
                    } else {
                        in_quotes = false
                        i += 1
                    }
                } else {
                    if c == "\n" {
                        line += 1
                    }
                    field = field.concat(c)
                    i += 1
                }
            } else {
                if c == "\"" && field == "" && !field_quoted {
                    in_quotes = true
                    field_quoted = true
                    started = true
                    i += 1
                } else if c == self.delimiter {
                    record.push(self._finish(field, field_quoted))
                    field = ""
                    field_quoted = false
                    started = true
                    i += 1
                } else if c == "\n" {
                    if started || record.len() > 0 || field_quoted {
                        record.push(self._finish(field, field_quoted))
                        records.push(record)
                        record = _new_row()
                    }
                    field = ""
                    field_quoted = false
                    started = false
                    line += 1
                    i += 1
                } else if c == "\r" {
                    i += 1
                } else {
                    field = field.concat(c)
                    started = true
                    i += 1
                }
            }
        }
        if in_quotes {
            return Err(CsvError.new(line, "unterminated quoted field"))
        }
        if started || record.len() > 0 || field_quoted {
            record.push(self._finish(field, field_quoted))
            records.push(record)
        }
        return Ok(self._to_sheet(records))
    }

    fun _finish(self, field: String, quoted: Bool) -> String {
        if self.trim && !quoted {
            return field.trim()
        }
        return field
    }

    fun _to_sheet(self, records: List<List<String>>) -> Sheet {
        if self.has_header && records.len() > 0 {
            let headers = records[0]
            let rows: List<List<String>> = []
            let i = 1
            while i < records.len() {
                rows.push(records[i])
                i += 1
            }
            return Sheet { headers, rows }
        }
        let no_headers: List<String> = []
        return Sheet { headers: no_headers, rows: records }
    }
}

// Serialize `rows` to CSV text with a comma delimiter, quoting fields that need
// it and terminating each record with a newline.
fun write(rows: List<List<String>>) -> String {
    return write_with(rows, ",")
}

// Serialize `rows` using `delimiter` as the field separator.
fun write_with(rows: List<List<String>>, delimiter: String) -> String {
    let out = ""
    let i = 0
    while i < rows.len() {
        let r = rows[i]
        let j = 0
        while j < r.len() {
            if j > 0 {
                out = out.concat(delimiter)
            }
            out = out.concat(_escape(r[j], delimiter))
            j += 1
        }
        out = out.concat("\n")
        i += 1
    }
    return out
}

// Quote a field when it contains the delimiter, a quote, or a line break,
// doubling any embedded quotes.
fun _escape(field: String, delimiter: String) -> String {
    let risky = field.contains(delimiter) || field.contains("\"") || field.contains("\n") || field.contains("\r")
    if risky {
        return "\"".concat(field.replace("\"", "\"\"")).concat("\"")
    }
    return field
}

fun _new_row() -> List<String> {
    let r: List<String> = []
    return r
}

fun _header_index(headers: List<String>, name: String) -> Int {
    let i = 0
    while i < headers.len() {
        if headers[i] == name {
            return i
        }
        i += 1
    }
    return 0 - 1
}
